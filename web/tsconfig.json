{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // boot.ts runs on the main thread (DOM) and worker.ts runs in a worker
    // (WebWorker). One project, so both libs are loaded; skipLibCheck keeps
    // their overlapping globals from being an error.
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    // WebGPU is not in TypeScript's DOM lib yet; worker.ts reads adapter
    // identity straight from the API, so it needs the official types.
    "types": ["vite/client", "@webgpu/types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
